{
  "$comment": "Allowed values for data/*.geojson. Shared by scripts/validate.mjs and the app. Add a value here (and a style/icon entry in src/) to extend the map.",
  "langs": ["en", "zh-Hans", "zh-Hant"],
  "extent": { "lon": [-0.2, 0.2], "lat": [-0.2, 0.2] },
  "layers": {
    "land": {
      "geometry": ["Polygon", "MultiPolygon"],
      "class": ["land"]
    },
    "landuse": {
      "geometry": ["Polygon", "MultiPolygon"],
      "class": ["urban", "industrial", "beach", "swamp", "park", "forest", "grass", "golf", "farmland", "airport", "runway", "water"]
    },
    "buildings": {
      "geometry": ["Polygon", "MultiPolygon"],
      "class": ["building"]
    },
    "roads": {
      "geometry": ["LineString", "MultiLineString"],
      "class": ["motorway", "trunk", "primary", "secondary", "street", "service", "track", "path", "rail", "ferry"]
    },
    "places": {
      "geometry": ["Point"],
      "kind": ["state", "county", "city", "town", "district", "island", "water", "airport", "landmark"]
    },
    "poi": {
      "geometry": ["Point", null],
      "category": ["vehicle", "weapon", "easter-egg", "shop", "gas", "pay-n-spray", "clothes", "barber", "tattoo", "food", "safehouse", "landmark", "activity", "collectible"],
      "flags": ["day", "night", "alarm", "tracker", "random", "later"]
    }
  }
}
